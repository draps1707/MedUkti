<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0F1115"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="6dp">

    <!-- Optional 1-Tap Save Fix Bar (hidden unless Undo -> correction occurs) -->
    <LinearLayout
        android:id="@+id/saveFixBar"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_card_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSaveFixLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Save fix?"
            android:textColor="#E8EAED"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnSaveFix"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_key_accent"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDismissFix"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#9AA0A6"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Row 1: Mode Toggle + Inline Mic Pill + Settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnModeToggle"
            android:layout_width="54dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_key_accent"
            android:gravity="center"
            android:text="MED"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/micRingContainer"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mic_pill_idle"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/ivKeyboardMic"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Speak"
                android:src="@android:drawable/ic_btn_speak_now"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvMicPillLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tap to Speak"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnOpenSettings"
            android:layout_width="40dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_key_action"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#E8EAED"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Row 2: Essential Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/keySwitchKb"
            android:layout_width="46dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_key_action"
            android:gravity="center"
            android:text="🌐"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/keyComma"
            android:layout_width="38dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_key_dark"
            android:gravity="center"
            android:text=","
            android:textColor="#E8EAED"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/keySpace"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_key_dark"
            android:gravity="center"
            android:text="Space"
            android:textColor="#9AA0A6"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/keyPeriod"
            android:layout_width="38dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_key_dark"
            android:gravity="center"
            android:text="."
            android:textColor="#E8EAED"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/keyUndo"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_key_action"
            android:gravity="center"
            android:text="Undo"
            android:textColor="#FDD663"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/keyBackspace"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_key_action"
            android:gravity="center"
            android:text="⌫"
            android:textColor="#E8EAED"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/keyEnter"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_key_accent"
            android:gravity="center"
            android:text="↵"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
