<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Card 1: Header & Keyboard Setup -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Medଉକ୍ତି Online"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="v6.2 • Medical, Hinglish, Odia &amp; Hindi"
                        android:textColor="#9AA0A6"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSetupBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_ready"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="Ready"
                    android:textColor="#6DD58C"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnEnableKb"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_key_action"
                    android:gravity="center"
                    android:text="Enable Keyboard"
                    android:textColor="#E8EAED"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnPickKb"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_compact"
                    android:gravity="center"
                    android:text="Switch Keyboard"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card 2: Free Cloud API Keys (BYOK) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FREE CLOUD API KEYS (100% FREE)"
                android:textColor="#8AB4F8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Groq Key Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Groq Key (MED / HIN)"
                    android:textColor="#E8EAED"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnGetGroqKey"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_key_action"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Get Free Key ↗"
                    android:textColor="#8AB4F8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnPasteGroqKey"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_key_action"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Paste"
                    android:textColor="#E8EAED"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/etGroqKey"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_dark"
                android:hint="gsk_... (free at console.groq.com)"
                android:inputType="textPassword"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#6E7681"
                android:textSize="13sp" />

            <!-- Gemini Key Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Gemini Key (OD / HI)"
                    android:textColor="#E8EAED"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnGetGeminiKey"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_key_action"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Get Free Key ↗"
                    android:textColor="#8AB4F8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnPasteGeminiKey"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_key_action"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Paste"
                    android:textColor="#E8EAED"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/etGeminiKey"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_dark"
                android:hint="AIza... (free at aistudio.google.com)"
                android:inputType="textPassword"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#6E7681"
                android:textSize="13sp" />

            <!-- Test Keys Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnTestKeys"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_key_action"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Test Keys ✓"
                    android:textColor="#6DD58C"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvKeyTestResult"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Tap Test Keys to verify"
                    android:textColor="#9AA0A6"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card 3: Built-in Dictionary Check & Personal Dictionary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MEDICAL DICTIONARY &amp; PERSONAL FIXES"
                android:textColor="#8AB4F8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etDictSearch"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_dark"
                    android:hint="Check built-in drug/term (e.g. Teicoplanin)"
                    android:paddingHorizontal="10dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#6E7681"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnDictSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_key_action"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Check"
                    android:textColor="#E8EAED"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDictSearchResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Built-in: generic drugs + clinical terminology active"
                android:textColor="#9AA0A6"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Personal Fixes (wrong = right)"
                    android:textColor="#E8EAED"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnBackupFixes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_compact"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="Copy Backup"
                    android:textColor="#2DD4BF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnRestoreFixes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_compact"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="Paste Restore"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/etPersonalDict"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_dark"
                android:gravity="top|start"
                android:hint="epixabin = Apixaban"
                android:inputType="textMultiLine"
                android:padding="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6E7681"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Collapsible Advanced Options -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/btnToggleAdvanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ADVANCED OPTIONS (MODELS &amp; VOICE) ▾"
                android:textColor="#8AB4F8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/advancedContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Default Mode"
                    android:textColor="#E8EAED"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerEngine"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_dark"
                    android:paddingHorizontal="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Medical / Hinglish Voice Model (Groq)"
                    android:textColor="#E8EAED"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerGroqAsr"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_dark"
                    android:paddingHorizontal="10dp" />

                <EditText
                    android:id="@+id/etGroqAsrModel"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_dark"
                    android:hint="Custom Groq STT model ID"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textColor="#E8EAED"
                    android:textColorHint="#6E7681"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="AI Context Polish Model (Groq)"
                    android:textColor="#E8EAED"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerGroqLlm"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_dark"
                    android:paddingHorizontal="10dp" />

                <EditText
                    android:id="@+id/etGroqLlmModel"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_dark"
                    android:hint="Custom Groq LLM model ID"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textColor="#E8EAED"
                    android:textColorHint="#6E7681"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Hinglish / Odia Backup Model (Gemini)"
                    android:textColor="#E8EAED"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerGeminiModel"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_dark"
                    android:paddingHorizontal="10dp" />

                <EditText
                    android:id="@+id/etGeminiModel"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_dark"
                    android:hint="Custom Gemini model ID"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textColor="#E8EAED"
                    android:textColorHint="#6E7681"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Odia (OD) Engine"
                    android:textColor="#E8EAED"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerOdiaBackend"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_dark"
                    android:paddingHorizontal="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="ElevenLabs API Key (for Odia Scribe v2)"
                    android:textColor="#E8EAED"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etElevenLabsKey"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_dark"
                        android:hint="sk_..."
                        android:inputType="textPassword|textNoSuggestions"
                        android:padding="12dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#9AA0A6"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btnPasteElevenLabsKey"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_btn_compact"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="Paste"
                        android:textColor="#E8EAED"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchAutoListen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Auto-listen when keyboard opens"
                    android:textColor="#E8EAED"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/switchLiveStream"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Live typing preview while speaking"
                    android:textColor="#E8EAED"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnSaveStart"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_btn_compact"
            android:gravity="center"
            android:text="Save Settings"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
