<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VoiceRambler Free"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Offline Medical + Indian English + Hinglish + Hindi + Odia"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnDlMedAsr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Download Google MedASR Medical Pack (Recommended)" />

        <Button
            android:id="@+id/btnDlParakeet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Download Parakeet TDT 110M English (~136 MB - Fast)" />

        <Button
            android:id="@+id/btnDlIndianEn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Download English (India) Live Pack (~71 MB)" />

        <Button
            android:id="@+id/btnDlAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Download All Offline Packs (Automatic Setup)" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Dictation Mode (Automatic by default)"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerEngine"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <Button
            android:id="@+id/btnDlWhisperApex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Download Whisper Hinglish Apex (~1.03 GB - Best Hinglish)" />

        <Button
            android:id="@+id/btnDlWhisperSwift" 
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Download Only Whisper Hinglish Swift (~152 MB)" />

        <Button
            android:id="@+id/btnDlIndicHi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Download Only IndicConformer Hindi (~661 MB)" />

        <Button
            android:id="@+id/btnDlIndicOr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Download Only IndicConformer Odia (~661 MB)" />

        <Button
            android:id="@+id/btnCompare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Open Recognition Lab (Compare Engines)" />

        <CheckBox
            android:id="@+id/cbGeminiOptional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Optional: Polish offline transcript with Gemini Cloud" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Optional Gemini API key (not required)"
            android:inputType="textPassword" />

        <Spinner
            android:id="@+id/spinnerModel"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <Button
            android:id="@+id/btnSaveStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Save &amp; Start Floating Mic" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
