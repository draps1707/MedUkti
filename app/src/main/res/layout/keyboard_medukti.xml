<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0B0E14"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/saveFixBar"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_card_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSaveFixLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Save fix?"
            android:textColor="#E2E8F0"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnSaveFix"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_key_accent"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDismissFix"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#9AA5B4"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnModeOdia"
            android:layout_width="40dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_key_dark"
            android:gravity="center"
            android:text="ଓ"
            android:textColor="#9AA5B4"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnModeMedical"
            android:layout_width="40dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_key_accent"
            android:gravity="center"
            android:text="🩺"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnModeHinglish"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_key_dark"
            android:gravity="center"
            android:text="हin"
            android:textColor="#9AA5B4"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/micRingContainer"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mic_pill_idle"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivKeyboardMic"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Speak"
                android:src="@android:drawable/ic_btn_speak_now"
                android:tint="#2DD4BF" />

            <com.medukti.keyboard.MicAnimView
                android:id="@+id/micAnimView"
                android:layout_width="44dp"
                android:layout_height="30dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/keyPaste"
            android:layout_width="44dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_key_action"
            android:gravity="center"
            android:text="📋"
            android:textColor="#E2E8F0"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/keyBackspace"
            android:layout_width="46dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_key_action"
            android:gravity="center"
            android:text="⌫"
            android:textColor="#E2E8F0"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
