<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Medଉକ୍ତି Online"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="v6.0.1 • Instant Cloud Medical, Hinglish &amp; Odia"
                        android:textColor="#9AA0A6"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSetupBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_ready"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="Ready"
                    android:textColor="#6DD58C"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnEnableKb"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_key_action"
                    android:gravity="center"
                    android:text="Enable Keyboard"
                    android:textColor="#E8EAED"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnPickKb"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_compact"
                    android:gravity="center"
                    android:text="Switch Keyboard"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card 1: Voice & Behaviour -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VOICE &amp; BEHAVIOUR"
                android:textColor="#8AB4F8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Default Mode"
                android:textColor="#E8EAED"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerEngine"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_dark"
                android:paddingHorizontal="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Posting Focus Pack (Whisper Bias)"
                android:textColor="#E8EAED"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerFocusPack"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_dark"
                android:paddingHorizontal="10dp" />

            <Switch
                android:id="@+id/switchAutoListen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Auto-listen when keyboard opens"
                android:textColor="#E8EAED"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switchLiveStream"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Live typing preview while speaking (MED)"
                android:textColor="#E8EAED"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switchAiPolish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="AI context polish (GPT-OSS 120B)"
                android:textColor="#E8EAED"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Card 2: Free Cloud API Keys (BYOK) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FREE CLOUD API KEYS (BYOK • ₹0/MO)"
                android:textColor="#8AB4F8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Groq Key Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Groq Key (MED)"
                    android:textColor="#E8EAED"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnGetGroqKey"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_key_action"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Get Free Key ↗"
                    android:textColor="#8AB4F8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnPasteGroqKey"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_key_action"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Paste"
                    android:textColor="#E8EAED"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/etGroqKey"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_dark"
                android:hint="gsk_... (free at console.groq.com)"
                android:inputType="textPassword"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#6E7681"
                android:textSize="13sp" />

            <!-- Gemini Key Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Gemini Key (OD)"
                    android:textColor="#E8EAED"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnGetGeminiKey"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_key_action"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Get Free Key ↗"
                    android:textColor="#8AB4F8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnPasteGeminiKey"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_key_action"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Paste"
                    android:textColor="#E8EAED"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/etGeminiKey"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_dark"
                android:hint="AIza... (free at aistudio.google.com)"
                android:inputType="textPassword"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#6E7681"
                android:textSize="13sp" />

            <!-- Test Keys Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnTestKeys"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_key_action"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Test Keys ✓"
                    android:textColor="#6DD58C"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvKeyTestResult"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Tap Test Keys to verify"
                    android:textColor="#9AA0A6"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="MODEL IDS (EDITABLE)"
                android:textColor="#9AA0A6"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etGroqAsrModel"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_dark"
                android:hint="whisper-large-v3"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#E8EAED"
                android:textColorHint="#6E7681"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etGroqLlmModel"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_dark"
                android:hint="openai/gpt-oss-120b"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#E8EAED"
                android:textColorHint="#6E7681"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etGeminiModel"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_dark"
                android:hint="gemini-3.5-flash-lite"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#E8EAED"
                android:textColorHint="#6E7681"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Card 3: Personal Dictionary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERSONAL DICTIONARY (WRONG = RIGHT)"
                android:textColor="#8AB4F8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPersonalDict"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_dark"
                android:gravity="top|start"
                android:hint="epixabin = Apixaban\npan dee = Pan-D"
                android:inputType="textMultiLine"
                android:padding="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6E7681"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSaveStart"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_btn_compact"
            android:gravity="center"
            android:text="Save Settings"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
