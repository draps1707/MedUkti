<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0F1115"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="6dp">

    <!-- Top Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnModeToggle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_key_accent"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="MED"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvImeStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Ready"
            android:textColor="#9AA0A6"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnDrawerRx"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_key_action"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="Rx"
            android:textColor="#8AB4F8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDrawerNum"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_key_action"
            android:gravity="center"
            android:paddingHorizontal="11dp"
            android:text="123"
            android:textColor="#E8EAED"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDrawerHistory"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_key_action"
            android:gravity="center"
            android:paddingHorizontal="11dp"
            android:text="Recent"
            android:textColor="#E8EAED"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnOpenSettings"
            android:layout_width="34dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_key_action"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#E8EAED"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Shortcut Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chipRow"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Center Dynamic Panel -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:layout_marginTop="6dp">

        <!-- 1. Sleek 120Hz Voice Pill (No Ring) -->
        <LinearLayout
            android:id="@+id/panelVoice"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/micRingContainer"
                android:layout_width="210dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_mic_pill_idle"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:id="@+id/ivKeyboardMic"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Speak"
                    android:src="@android:drawable/ic_btn_speak_now"
                    android:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/tvMicPillLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Tap to Speak"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvVoiceHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="MedUkti • 100% Offline"
                android:textColor="#80868B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 2. Rx Snippets & Templates Drawer -->
        <LinearLayout
            android:id="@+id/panelRx"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etSnippetSearch"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:background="@drawable/bg_key_dark"
                android:hint="Search Rx snippets / templates..."
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#80868B"
                android:textSize="12sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/rxListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!-- 3. Clinical Numpad & Units Panel -->
        <LinearLayout
            android:id="@+id/panelNumpad"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/numRow1"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/numRow2"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:layout_marginTop="3dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/numRow3"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:layout_marginTop="3dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- 4. Recent Dictations Panel -->
        <ScrollView
            android:id="@+id/panelHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/historyListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </FrameLayout>

    <!-- Fixed Bottom Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/keySwitchKb"
            android:layout_width="46dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_key_action"
            android:gravity="center"
            android:text="🌐"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/keyComma"
            android:layout_width="38dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_key_dark"
            android:gravity="center"
            android:text=","
            android:textColor="#E8EAED"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/keySpace"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_key_dark"
            android:gravity="center"
            android:text="MedUkti"
            android:textColor="#9AA0A6"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/keyPeriod"
            android:layout_width="38dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_key_dark"
            android:gravity="center"
            android:text="."
            android:textColor="#E8EAED"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/keyUndo"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_key_action"
            android:gravity="center"
            android:text="Undo"
            android:textColor="#FDD663"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/keyBackspace"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_key_action"
            android:gravity="center"
            android:text="⌫"
            android:textColor="#E8EAED"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/keyEnter"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_key_accent"
            android:gravity="center"
            android:text="↵"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
