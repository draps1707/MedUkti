<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#121417"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top Toolbar: Mode Toggle, Status, Drawers, Settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnModeToggle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="#1E88E5"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="MED"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvImeStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tap mic to speak"
            android:textColor="#B0BEC5"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnDrawerRx"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="#263238"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Rx"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDrawerNum"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="#263238"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="123"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDrawerHistory"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="#263238"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Recent"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnOpenSettings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#263238"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Context-Aware Quick Shortcut Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chipRow"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Center Dynamic Panel (Voice / Rx Snippets / Numpad / Recent) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="146dp"
        android:layout_marginTop="6dp">

        <!-- 1. Voice Panel -->
        <LinearLayout
            android:id="@+id/panelVoice"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/micRingContainer"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:background="@drawable/bg_mic_ring">

                <ImageView
                    android:id="@+id/ivKeyboardMic"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:contentDescription="Speak"
                    android:src="@android:drawable/ic_btn_speak_now"
                    android:tint="#FFFFFF" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvVoiceHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="MedUkti • 100% Offline"
                android:textColor="#90A4AE"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 2. Rx Snippets & Templates Drawer -->
        <LinearLayout
            android:id="@+id/panelRx"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etSnippetSearch"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:background="#1E242B"
                android:hint="Search Rx snippets / templates..."
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#78909C"
                android:textSize="12sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/rxListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!-- 3. Clinical Numpad & Units Panel -->
        <LinearLayout
            android:id="@+id/panelNumpad"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/numRow1"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/numRow2"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/numRow3"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- 4. Recent Dictations Panel -->
        <ScrollView
            android:id="@+id/panelHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/historyListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </FrameLayout>

    <!-- Fixed Bottom Bar (Gboard / Samsung style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/keySwitchKb"
            android:layout_width="46dp"
            android:layout_height="40dp"
            android:background="#263238"
            android:gravity="center"
            android:text="🌐"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/keyComma"
            android:layout_width="38dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="#1E242B"
            android:gravity="center"
            android:text=","
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/keySpace"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="#1E242B"
            android:gravity="center"
            android:text="Space"
            android:textColor="#B0BEC5"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/keyPeriod"
            android:layout_width="38dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="#1E242B"
            android:gravity="center"
            android:text="."
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/keyUndo"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="#263238"
            android:gravity="center"
            android:text="Undo"
            android:textColor="#FFCC80"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/keyBackspace"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="#263238"
            android:gravity="center"
            android:text="⌫"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/keyEnter"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="#1E88E5"
            android:gravity="center"
            android:text="↵"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
