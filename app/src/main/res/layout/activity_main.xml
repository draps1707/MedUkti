<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MedUkti"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="100% Offline Indian English &amp; Odia Voice Keyboard"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEnableKb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="1. Enable Keyboard" />

            <Button
                android:id="@+id/btnPickKb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="2. Switch Keyboard" />
        </LinearLayout>

        <Switch
            android:id="@+id/switchAutoListen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Auto-listen when MedUkti keyboard opens" />

        <Switch
            android:id="@+id/switchStreamingDraft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Live Indian-English streaming draft (Beta)" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Active Mode"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerEngine"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <Button
            android:id="@+id/btnDlWhisperTurbo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Download Whisper Large-v3-Turbo (~1.04 GB - Best Open Indian EN)" />

        <Button
            android:id="@+id/btnDlStreamingDraft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Download Indian-EN Streaming Draft (~71 MB)" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Hugging Face Token (only needed for gated Parakeet-Indic v1)"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etHfToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="hf_..."
            android:inputType="textNoSuggestions"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnDlParakeetIndic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Download Parakeet-Indic v1 (~850 MB - Needs HF Approval)" />

        <Button
            android:id="@+id/btnDlMedAsr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Download Google MedASR CTC (Optional Clinical)" />

        <Button
            android:id="@+id/btnDlParakeet06b"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Download Parakeet TDT 0.6B v2 (~661 MB)" />

        <Button
            android:id="@+id/btnDlIndicOr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Download Odia Offline Pack (~661 MB)" />

        <Button
            android:id="@+id/btnDlSraVaani"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Download SraVaani 1.0 Odia Natural (~1.81 GB)" />

        <Button
            android:id="@+id/btnCompare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Compare Engines Side-by-Side (Lab)" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Personal Dictionary (one per line: wrong = right)"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPersonalDict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="Example:\nsubhu = Subhu\naau kana = ଆଉ କଣ"
            android:inputType="textMultiLine"
            android:minLines="3" />

        <Button
            android:id="@+id/btnSaveStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Save Settings &amp; Preload Mode" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
